{
  "name": "@snap-engine/core",
  "version": "0.4.2",
  "description": "Interactivity engine for the web",
  "type": "module",
  "workspaces": [
    "assets/asset-base",
    "assets/snapsort",
    "assets/snapline",
    "assets/snapzap/*"
  ],
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./debug": {
      "types": "./src/debug.ts",
      "import": "./src/debug.ts"
    },
    "./animation": {
      "types": "./src/animation.ts",
      "import": "./src/animation.ts"
    },
    "./collision": {
      "types": "./src/collision.ts",
      "import": "./src/collision.ts"
    },
    "./geometry": {
      "types": "./src/geometry.ts",
      "import": "./src/geometry.ts"
    },
    "./layout": {
      "types": "./src/layout.ts",
      "import": "./src/layout.ts"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev:vanilla": "FRAMEWORK=vanilla vite build --mode development --watch & npm run server:vanilla",
    "dev:react": "FRAMEWORK=react vite build --mode development --watch & npm run server:react",
    "dev:svelte": "FRAMEWORK=svelte vite build --mode development --watch & npm run server:svelte",
    "server:vanilla": "FRAMEWORK=vanilla vite serve demo/vanilla --config demo/vanilla/vite.config.mjs --host",
    "server:react": "FRAMEWORK=react vite serve demo/react --config demo/react/vite.config.mjs --host",
    "server:svelte": "FRAMEWORK=svelte vite serve demo/svelte --config demo/svelte/vite.config.mjs --host",
    "dev:all": "concurrently --kill-others \"npm run dev:vanilla\" \"npm run dev:react\"",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:core-ut": "playwright test tests/ut/core-*.spec.ts tests/ut/transform.spec.ts tests/ut/frame-controller.spec.ts --project=chromium",
    "test:snapline-ut": "playwright test tests/ut/snapline-*.spec.ts --project=chromium",
    "test:snapsort-ut": "playwright test tests/ut/snapsort-*.spec.ts --project=chromium",
    "test:e2e": "npm run test:core -- --project=chromium && npm run test:asset-base && npm run test:snapline && npm run test:snapsort",
    "test:core": "playwright test -c tests/e2e/core/playwright.config.ts",
    "test:core-zoom": "playwright test -c tests/e2e/core/playwright.config.ts measure/",
    "test:asset-base": "playwright test -c tests/e2e/asset-base/playwright.config.ts",
    "test:camera-control": "playwright test -c tests/e2e/asset-base/playwright.config.ts --project=svelte camera-control/",
    "test:camera-control-react": "playwright test -c tests/e2e/asset-base/playwright.config.ts --project=react camera-control/",
    "test:asset-base-react": "playwright test -c tests/e2e/asset-base/playwright.config.ts --project=react react-context/",
    "test:snapline": "playwright test -c tests/e2e/snapline/playwright.config.ts",
    "test:snapline-nodes": "playwright test -c tests/e2e/snapline/playwright.config.ts --project=svelte nodes/",
    "test:snapline-camera": "playwright test -c tests/e2e/snapline/playwright.config.ts --project=svelte camera/",
    "test:snapline-edges": "playwright test -c tests/e2e/snapline/playwright.config.ts --project=svelte edges/edges.spec.ts",
    "test:snapline-overlay": "playwright test -c tests/e2e/snapline/playwright.config.ts --project=svelte edges/overlay.spec.ts",
    "test:snapline-group": "playwright test -c tests/e2e/snapline/playwright.config.ts --project=svelte group/",
    "test:snapline-resize": "playwright test -c tests/e2e/snapline/playwright.config.ts --project=svelte resize/",
    "test:snapline-react": "playwright test -c tests/e2e/snapline/playwright.config.ts --project=react",
    "test:snapsort": "playwright test -c tests/e2e/snapsort/playwright.config.ts",
    "test:snapsort-svelte": "playwright test -c tests/e2e/snapsort/playwright.config.ts --project=svelte-chromium",
    "test:snapsort-react": "playwright test -c tests/e2e/snapsort/playwright.config.ts --project=react-chromium",
    "test:layout": "playwright test -c tests/e2e/snapsort/layout.playwright.config.ts",
    "promo:snapsort": "playwright test -c tests/promo/snapsort-promo.playwright.config.ts && node scripts/convert-snapsort-promo.mjs",
    "render:collision-dots": "node scripts/render_collision_text_dots.mjs",
    "format": "prettier --write src",
    "lint": "eslint src assets/snapline --ext .ts",
    "build": "vite build --mode production",
    "build:dev": "FRAMEWORK=test npx vite build --mode development",
    "check:snapsort-api": "tsc -p tests/types/tsconfig.snapsort-api.json",
    "check:tests": "tsc -p tsconfig.tests.json",
    "validate:packages": "node scripts/validate-packages.mjs",
    "check:website": "npm run check --prefix website",
    "check:adapters": "FRAMEWORK=test svelte-check --tsconfig assets/asset-base/tsconfig.json && FRAMEWORK=test svelte-check --tsconfig assets/snapsort/tsconfig.json && FRAMEWORK=test svelte-check --tsconfig assets/snapline/tsconfig.json",
    "typecheck": "tsc --noEmit",
    "ci": "npm run validate:packages && npm run check:snapsort-api && npm run check:tests && npm run test:core-ut && npm run test:snapsort-ut && npm run test:snapline-ut && npm run typecheck && npm run lint && npm run check:adapters && npm run check:website && npm run build",
    "prepublishOnly": "npm run lint",
    "wdio": "wdio run ./wdio.conf.ts"
  },
  "keywords": [
    "ui",
    "interactive",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tfukaza/SnapEngineJS.git"
  },
  "author": "Tomoki Fukazawa",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tfukaza/SnapEngineJS/issues"
  },
  "homepage": "https://github.com/tfukaza/SnapEngineJS#readme",
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "brace-expansion@1": "1.1.16",
    "picomatch@2": "2.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.6.0",
    "@playwright/test": "^1.61.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/eslint__js": "^8.42.3",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.14.11",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "fontkit": "^2.0.4",
    "jsdom": "^25.0.1",
    "prettier": "3.3.2",
    "puppeteer": "^22.13.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sass": "^1.75.0",
    "start-server-and-test": "^2.0.4",
    "svelte-check": "^4.7.3",
    "terser": "^5.31.1",
    "tslib": "^2.6.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^7.15.0",
    "uglify-js": "^3.17.4",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.5.4"
  }
}
