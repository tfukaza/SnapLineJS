{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@snap-engine/core": ["../../src/index.ts"],
      "@snap-engine/core/animation": ["../../src/animation.ts"],
      "@snap-engine/core/collision": ["../../src/collision.ts"],
      "@snap-engine/core/debug": ["../../src/debug.ts"],
      "@snap-engine/asset-base": ["../asset-base/src/index.ts"],
      "@snap-engine/asset-base/react": ["../asset-base/src/react/index.ts"],
      "@snap-engine/snapsort": ["./src/index.ts"],
      "@snap-engine/snapsort/*": ["./src/*"],
      "@snap-engine/snapsort/svelte": ["./src/svelte/index.ts"],
      "@snap-engine/snapsort/svelte/*": ["./src/svelte/*"],
      "@snap-engine/snapsort/react": ["./src/react/index.ts"],
      "@snap-engine/snapsort/react/*": ["./src/react/*"]
    }
  },
  "include": ["src/**/*"]
}
