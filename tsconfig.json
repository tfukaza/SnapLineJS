{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ESNext", "DOM"],
    "moduleResolution": "Node",
    "allowArbitraryExtensions": true,
    "strict": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "rootDirs": ["src", "demo"],
    "outDir": "out-tsc",
    "paths": {
      "@/*": ["./src/*"],
      "@snap-engine/core": ["./src/index.ts"],
      "@snap-engine/core/animation": ["./src/animation.ts"],
      "@snap-engine/core/collision": ["./src/collision.ts"],
      "@snap-engine/core/debug": ["./src/debug.ts"],
      "@snap-engine/core/geometry": ["./src/geometry.ts"],
      "@snap-engine/asset-base/svelte": [
        "./assets/asset-base/src/svelte/index.ts"
      ],
      "@snap-engine/asset-base/svelte/*": ["./assets/asset-base/src/svelte/*"],
      "@snap-engine/asset-base/react": [
        "./assets/asset-base/src/react/index.ts"
      ],
      "@snap-engine/asset-base/react/*": ["./assets/asset-base/src/react/*"],
      "@snap-engine/asset-base": ["./assets/asset-base/src/index.ts"],
      "@snap-engine/asset-base/*": ["./assets/asset-base/src/*"],
      "@snap-engine/snapsort/svelte": ["./assets/snapsort/src/svelte/index.ts"],
      "@snap-engine/snapsort/svelte/*": ["./assets/snapsort/src/svelte/*"],
      "@snap-engine/snapsort/react": ["./assets/snapsort/src/react/index.ts"],
      "@snap-engine/snapsort/react/*": ["./assets/snapsort/src/react/*"],
      "@snap-engine/snapsort": ["./assets/snapsort/src/index.ts"],
      "@snap-engine/snapsort/*": ["./assets/snapsort/src/*"],
      "@snap-engine/snapline/svelte": ["./assets/snapline/src/svelte/index.ts"],
      "@snap-engine/snapline/svelte/*": ["./assets/snapline/src/svelte/*"],
      "@snap-engine/snapline/react": ["./assets/snapline/src/react/index.ts"],
      "@snap-engine/snapline/react/*": ["./assets/snapline/src/react/*"],
      "@snap-engine/snapline": ["./assets/snapline/src/index.ts"],
      "@snap-engine/snapline/*": ["./assets/snapline/src/*"]
    },
    "jsx": "react-jsx"
  },
  "include": ["src", "demo"]
}
